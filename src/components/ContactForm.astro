---
interface Props {
  headline: string;
  text: string;
  hinweis: string;
}

const { headline, text, hinweis } = Astro.props;
---

<div class="rounded-lg border border-border bg-background p-6 shadow-sm md:p-8">
  <h2 class="mb-2 font-heading text-2xl font-bold text-text">{headline}</h2>
  <p class="mb-6 text-text-muted">{text}</p>

  <iframe
    data-tally-src="https://tally.so/embed/yPAZBB?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
    loading="lazy"
    width="100%"
    height="545"
    title="Frage stellen"
  ></iframe>
  <script is:inline async src="https://tally.so/widgets/embed.js"></script>

  <p class="mt-6 text-sm text-text-muted">{hinweis}</p>
</div>
