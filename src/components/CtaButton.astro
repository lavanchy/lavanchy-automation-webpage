---
import { siteConfig } from '../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a
  href={siteConfig.calendlyUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-block rounded-md bg-brand-primary px-6 py-3 font-heading text-white transition-colors hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary ${className}`}
>
  {siteConfig.ctaLabel}
</a>
