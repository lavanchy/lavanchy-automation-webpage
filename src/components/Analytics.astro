---
// Plausible (self-hosted, siehe Datenschutzerklärung Ziff. 5) + zwei Ziele:
// «Erstgespräch Klick» (Link zu meetergo) und «Kontaktformular gesendet» (Tally-iframe
// meldet das Absenden per postMessage). Es werden keine Formularinhalte übermittelt.
---

<script async src="https://analytics.lavanchyautomation.ch/js/pa-Xex5KYHBg7ual4y0-sKhq.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()

  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('a[href^="https://cal.meetergo.com/"]');
    if (link) plausible('Erstgespräch Klick', { props: { seite: location.pathname } });
  });

  window.addEventListener('message', function (e) {
    if (e.origin !== 'https://tally.so' || typeof e.data !== 'string') return;
    try {
      if (JSON.parse(e.data).event === 'Tally.FormSubmitted') {
        plausible('Kontaktformular gesendet', { props: { seite: location.pathname } });
      }
    } catch (_) {}
  });
</script>
