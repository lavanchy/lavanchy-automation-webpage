---
interface Props {
  name: string;
  text: string;
  url?: string;
}

const { name, text, url } = Astro.props;
---

<div class="flex h-full flex-col rounded-lg border border-border bg-background p-6 shadow-sm">
  <h3 class="mb-3 font-heading text-xl font-bold text-text">{name}</h3>
  <p class="mb-4 leading-relaxed text-text-muted">{text}</p>
  {
    url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-auto font-body font-semibold text-brand-primary hover:underline"
      >
        {name} besuchen ↗
      </a>
    )
  }
</div>
