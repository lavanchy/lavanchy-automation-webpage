---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  dark?: boolean;
}

const { stats, dark = false } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    stats.map((stat) => (
      <div class={`rounded-lg border p-6 text-center ${dark ? 'border-white/20' : 'border-border bg-background shadow-sm'}`}>
        <p class={`font-heading text-3xl font-bold ${dark ? 'text-teal' : 'text-brand-primary'}`}>{stat.value}</p>
        <p class={`mt-2 text-sm ${dark ? 'text-white/85' : 'text-text-muted'}`}>{stat.label}</p>
      </div>
    ))
  }
</div>
