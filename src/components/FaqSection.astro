---
interface FaqItem {
  frage: string;
  antwort: string[];
}
interface FaqGroup {
  label: string;
  items: FaqItem[];
}
interface Props {
  headline: string;
  intro: string;
  gruppen: FaqGroup[];
}

const { headline, intro, gruppen } = Astro.props;
---

<div>
  <h2 class="mb-2 font-heading text-3xl font-bold text-text">{headline}</h2>
  <p class="mb-10 max-w-3xl leading-relaxed text-text-muted">{intro}</p>

  <div class="space-y-10">
    {
      gruppen.map((gruppe) => (
        <div>
          <p class="mb-3 font-heading text-sm font-bold tracking-wide text-brand-primary uppercase">{gruppe.label}</p>
          <div class="divide-y divide-border border-t border-b border-border">
            {gruppe.items.map((item) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold text-text marker:content-none">
                  {item.frage}
                  <span class="shrink-0 text-xl text-brand-primary transition-transform group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="mt-3 space-y-3 leading-relaxed text-text-muted">
                  {item.antwort.map((p) => <p>{p}</p>)}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
