---
import { navByLocale, getLocale, uiByLocale } from '../config/site';

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLocale = getLocale(currentPath);
const nav = navByLocale[currentLocale];
---

<nav id={id} aria-label={uiByLocale[currentLocale].navAriaLabel} class={className}>
  <ul class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-center md:gap-6">
    {nav.map((item) => {
      const isCurrent = currentPath === item.href;
      return (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent ? 'page' : undefined}
            class="font-body text-text hover:text-brand-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary aria-[current=page]:font-bold aria-[current=page]:text-brand-primary"
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
