---
interface Props {
  text: string;
  label?: string;
}

const { text, label } = Astro.props;
---

<div class="flex h-full flex-col rounded-lg border border-border bg-surface p-4">
  {
    label ? (
      <>
        <p class="mb-1 font-heading text-xs font-semibold uppercase tracking-wide text-brand-primary">{label}</p>
        <p class="leading-relaxed text-text-muted">{text}</p>
      </>
    ) : (
      <div class="flex items-start gap-3">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-primary" />
        <p class="leading-relaxed text-text-muted">{text}</p>
      </div>
    )
  }
</div>
