---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-text-muted">
    <p>&copy; {year} {siteConfig.name}</p>
    <div class="flex flex-wrap items-center gap-4">
      <ul class="flex gap-4">
        <li><a href="/de/impressum/" class="hover:text-brand-primary">Impressum</a></li>
        <li><a href="/de/datenschutz/" class="hover:text-brand-primary">Datenschutz</a></li>
        <li><a href="/de/agb/" class="hover:text-brand-primary">AGB</a></li>
      </ul>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Loïc Lavanchy auf LinkedIn"
        class="text-text-muted hover:text-brand-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
