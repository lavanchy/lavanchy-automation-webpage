---
import { getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import TitledCard from '../../components/TitledCard.astro';
import Tile from '../../components/Tile.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import CtaButton from '../../components/CtaButton.astro';
import FaqSection from '../../components/FaqSection.astro';
import { siteConfig } from '../../config/site';

const entry = await getEntry('leistungenEn', 'leistungen');
if (!entry) throw new Error('Content entry "leistungen" (en) not found');
const { hero, n8n, zusammenarbeit, mittenCta, qualitaet, managedKi, faq, fuerWen, abschlussCta } = entry.data;

const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: n8n.headline,
      description: n8n.intro[0],
      provider: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
      areaServed: 'DACH',
    },
    {
      '@type': 'Service',
      name: managedKi.headline,
      description: managedKi.intro[0],
      provider: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
      areaServed: 'DACH',
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.gruppen.flatMap((gruppe) =>
    gruppe.items.map((item) => ({
      '@type': 'Question',
      name: item.frage,
      acceptedAnswer: { '@type': 'Answer', text: item.antwort },
    }))
  ),
};
---

<PageLayout title={entry.data.seo.title} description={entry.data.seo.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(servicesJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Hero eyebrow={hero.eyebrow} headline={hero.headline} subheadline={hero.subheadline} />

  <Section>
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{n8n.headline}</h2>
    <div class="mb-8 max-w-3xl space-y-3 leading-relaxed text-text-muted">
      {n8n.intro.map((p) => <p>{p}</p>)}
    </div>

    <h3 class="mb-4 font-heading text-xl font-bold text-text">{n8n.bulletsHeadline}</h3>
    <div class="mb-10 grid gap-4 sm:grid-cols-2">
      {n8n.bullets.map((bullet) => <Tile text={bullet} />)}
    </div>

    <div class="mb-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-border bg-background shadow-sm p-6">
        <h3 class="mb-3 font-heading text-lg font-bold text-text">{n8n.kiHeadline}</h3>
        <div class="space-y-3 leading-relaxed text-text-muted">
          {n8n.kiText.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="rounded-lg border border-border bg-background shadow-sm p-6">
        <h3 class="mb-3 font-heading text-lg font-bold text-text">{n8n.tempoHeadline}</h3>
        <p class="leading-relaxed text-text-muted">{n8n.tempoText}</p>
      </div>
    </div>

    <h3 class="mb-4 font-heading text-xl font-bold text-text">{n8n.beispieleHeadline}</h3>
    <div class="grid gap-6 md:grid-cols-3">
      {n8n.beispiele.map((item) => <TitledCard title={item.title} text={item.text} />)}
    </div>
  </Section>

  <Section bg="paper" class="bg-surface">
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{zusammenarbeit.headline}</h2>
    <p class="mb-10 max-w-3xl leading-relaxed text-text-muted">{zusammenarbeit.intro}</p>
    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        zusammenarbeit.schritte.map((schritt, i) => (
          <li>
            <TitledCard title={schritt.title} text={schritt.text} index={i + 1} />
          </li>
        ))
      }
    </ol>
  </Section>

  <Section class="text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="mb-4 font-heading text-2xl font-bold text-text">{mittenCta.headline}</h2>
      <p class="mb-6 leading-relaxed text-text-muted">{mittenCta.text}</p>
      <CtaButton label={mittenCta.ctaLabel} />
    </div>
  </Section>

  <Section bg="paper" class="bg-surface">
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{qualitaet.headline}</h2>
    <div class="mb-10 max-w-3xl space-y-3 leading-relaxed text-text-muted">
      <p>{qualitaet.introSatz}</p>
      <ul class="space-y-2">
        {
          qualitaet.introBullets.map((bullet) => (
            <li class="flex items-start gap-2">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-primary" />
              {bullet}
            </li>
          ))
        }
      </ul>
      <p>{qualitaet.introAbschluss}</p>
      <p>
        {qualitaet.pruefungVorLink}
        <a
          href={qualitaet.linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-brand-primary hover:underline"
        >
          {qualitaet.linkStephan}
        </a>
        {qualitaet.pruefungZwischenLinks}
        <a
          href={qualitaet.linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-brand-primary hover:underline"
        >
          {qualitaet.linkLexGeneralis}
        </a>
        {qualitaet.pruefungNachLink}
      </p>
    </div>

    <div class="mb-8 grid gap-6 md:grid-cols-2">
      {qualitaet.cards.map((card) => <TitledCard title={card.title} text={card.text} />)}
    </div>

    <p class="text-sm text-text-muted">{qualitaet.hinweis}</p>
  </Section>

  <Section>
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{managedKi.headline}</h2>
    <div class="mb-8 max-w-3xl space-y-3 leading-relaxed text-text-muted">
      {managedKi.intro.map((p) => <p>{p}</p>)}
    </div>

    <h3 class="mb-4 font-heading text-xl font-bold text-text">{managedKi.bulletsHeadline}</h3>
    <div class="mb-10 grid gap-4 sm:grid-cols-2">
      {managedKi.bullets.map((bullet) => <Tile text={bullet} />)}
    </div>

    <div class="rounded-lg border border-border bg-background shadow-sm p-6">
      <h3 class="mb-3 font-heading text-lg font-bold text-text">{managedKi.grundsatzHeadline}</h3>
      <p class="leading-relaxed text-text-muted">{managedKi.grundsatzText}</p>
    </div>
  </Section>

  <Section bg="paper" class="bg-surface">
    <FaqSection headline={faq.headline} intro={faq.intro} gruppen={faq.gruppen} />
  </Section>

  <Section bg="paper" class="bg-surface text-center">
    <h2 class="mb-4 font-heading text-2xl font-bold text-text">{fuerWen.headline}</h2>
    <p class="mx-auto max-w-3xl leading-relaxed text-text">{fuerWen.text}</p>
  </Section>

  <ClosingCta headline={abschlussCta.headline} text={abschlussCta.text} buttonLabel={abschlussCta.buttonLabel} />
</PageLayout>
