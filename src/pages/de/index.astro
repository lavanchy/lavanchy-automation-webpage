---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import CtaButton from '../../components/CtaButton.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Content entry "home" not found');
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="mb-6 font-heading text-4xl font-bold text-text">{entry.data.title}</h1>
    <div class="space-y-4 leading-relaxed text-text">
      <Content />
    </div>
    <div class="mt-8">
      <CtaButton />
    </div>
  </section>
</PageLayout>
