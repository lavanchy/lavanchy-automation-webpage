---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import TitledCard from '../../components/TitledCard.astro';
import Testimonial from '../../components/Testimonial.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import portrait from '../../assets/brand/loic-portrait.jpg';

const entry = await getEntry('ueberMich', 'ueber-mich');
if (!entry) throw new Error('Content entry "ueber-mich" not found');
const { hero, werdegang, wieIchArbeite, wieIchVorgehe, testimonials, linkedinNote, persoenliches, abschlussCta } =
  entry.data;
---

<PageLayout title={entry.data.seo.title} description={entry.data.seo.description}>
  <Hero eyebrow={hero.eyebrow} headline={hero.headline} subheadline={hero.subheadline} />

  <Section>
    <div class="grid items-start gap-10 md:grid-cols-3">
      <Image
        src={portrait}
        alt="Loïc Lavanchy"
        width={320}
        class="mx-auto w-full max-w-[240px] rounded-lg md:col-span-1"
      />
      <div class="md:col-span-2">
        <h2 class="mb-4 font-heading text-3xl font-bold text-text">{werdegang.headline}</h2>
        <div class="space-y-4 leading-relaxed text-text-muted">
          {werdegang.text.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </Section>

  <Section bg="paper" class="bg-surface">
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{wieIchArbeite.headline}</h2>
    <div class="mb-8 max-w-3xl space-y-4 leading-relaxed text-text-muted">
      {wieIchArbeite.text.map((p) => <p>{p}</p>)}
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        wieIchArbeite.grundsaetze.map((item, i) => (
          <TitledCard title={item.title} text={item.text} index={i + 1} />
        ))
      }
    </div>
  </Section>

  <Section>
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{wieIchVorgehe.headline}</h2>
    <p class="mb-8 max-w-3xl leading-relaxed text-text-muted">{wieIchVorgehe.text}</p>
    <ol class="mb-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        wieIchVorgehe.schritte.map((schritt, i) => (
          <li>
            <TitledCard title={schritt.title} text={schritt.text} index={i + 1} />
          </li>
        ))
      }
    </ol>
    <p class="max-w-3xl leading-relaxed text-text-muted">{wieIchVorgehe.abschlussText}</p>
  </Section>

  <Section bg="paper" class="bg-surface">
    <h2 class="mb-8 font-heading text-3xl font-bold text-text">Was andere über die Zusammenarbeit sagen</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {
        testimonials.map((t) => (
          <Testimonial name={t.name} quote={t.quote} role={t.role} translationNote={t.translationNote} />
        ))
      }
    </div>
    <p class="mt-6 text-sm text-text-muted">
      {linkedinNote}
      {' '}
      <a href="https://www.linkedin.com/in/loic-lavanchy/" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-primary hover:underline">
        Zu LinkedIn →
      </a>
    </p>
  </Section>

  <Section>
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{persoenliches.headline}</h2>
    <p class="mb-6 max-w-3xl leading-relaxed text-text-muted">{persoenliches.intro}</p>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        persoenliches.items.map((item) => (
          <li class="flex items-start gap-2 leading-relaxed text-text-muted">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-primary" />
            {item}
          </li>
        ))
      }
    </ul>
  </Section>

  <ClosingCta headline={abschlussCta.headline} text={abschlussCta.text} buttonLabel={abschlussCta.buttonLabel} />
</PageLayout>
