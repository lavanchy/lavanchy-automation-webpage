---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageLayout
  title="Blog"
  description="Beiträge rund um ERP-Integration, n8n-Automatisierung und KI für KMU."
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="mb-6 font-heading text-4xl font-bold text-text">Blog</h1>
    {
      posts.length === 0 ? (
        <p class="text-text-muted">
          Noch keine Beiträge. Der Blog wird künftig automatisiert aus LinkedIn-Beiträgen befüllt.
        </p>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li>
              <a href={`/de/blog/${post.id}/`} class="font-heading text-xl text-brand-primary hover:underline">
                {post.data.title}
              </a>
              <p class="text-text-muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</PageLayout>
