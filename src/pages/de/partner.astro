---
import { getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import CtaButton from '../../components/CtaButton.astro';

const entry = await getEntry('partner', 'partner');
if (!entry) throw new Error('Content entry "partner" not found');
const { hero, warum, partners, rechtlicheBegleitung, kontaktHinweis } = entry.data;
---

<PageLayout title={entry.data.seo.title} description={entry.data.seo.description}>
  <Hero eyebrow={hero.eyebrow} headline={hero.headline} subheadline={hero.subheadline} />

  <Section>
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{warum.headline}</h2>
    <p class="mb-6 max-w-3xl leading-relaxed text-text-muted">{warum.text}</p>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        warum.items.map((item) => (
          <li class="flex items-start gap-2 leading-relaxed text-text-muted">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-primary" />
            {item}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section bg="paper" class="bg-surface">
    <div class="grid gap-6 md:grid-cols-2">
      {partners.map((partner) => <PartnerCard name={partner.name} text={partner.text} url={partner.url} />)}
    </div>
  </Section>

  <Section>
    <h2 class="mb-4 font-heading text-3xl font-bold text-text">{rechtlicheBegleitung.headline}</h2>
    <div class="max-w-3xl rounded-lg border border-border bg-background p-6 shadow-sm">
      <p class="mb-4 leading-relaxed text-text-muted">{rechtlicheBegleitung.text}</p>
      <a
        href={rechtlicheBegleitung.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-body font-semibold text-brand-primary hover:underline"
      >
        {rechtlicheBegleitung.linkLabel} ↗
      </a>
    </div>
  </Section>

  <Section bg="paper" class="bg-surface text-center">
    <div class="mx-auto max-w-2xl">
      <p class="mb-6 leading-relaxed text-text">{kontaktHinweis.text}</p>
      <CtaButton label={kontaktHinweis.ctaLabel} />
    </div>
  </Section>
</PageLayout>
