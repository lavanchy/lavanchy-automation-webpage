---
import { getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import TitledCard from '../../components/TitledCard.astro';
import Tile from '../../components/Tile.astro';
import StatGrid from '../../components/StatGrid.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import CtaButton from '../../components/CtaButton.astro';

const entry = await getEntry('referenzen', 'referenzen');
if (!entry) throw new Error('Content entry "referenzen" not found');
const { hero, fallstudien, weitereIdeen, fallstudienHinweis, abschlussCta } = entry.data;
---

<PageLayout title={entry.data.seo.title} description={entry.data.seo.description}>
  <Hero eyebrow={hero.eyebrow} headline={hero.headline} subheadline={hero.subheadline} />

  {
    fallstudien.map((fallstudie, i) => (
      <Section class={i % 2 === 1 ? 'bg-surface' : ''}>
        <h2 class="mb-8 font-heading text-3xl font-bold text-text">{fallstudie.headline}</h2>
        <div class="mb-8 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          {fallstudie.ausgangslage.map((p) => <Tile label="Ausgangslage" text={p} />)}
          {fallstudie.loesung.map((p) => <Tile label="Lösung" text={p} />)}
          {fallstudie.mehrwert.map((p) => <Tile label="Mehrwert" text={p} />)}
        </div>
        <StatGrid stats={fallstudie.stats} />
      </Section>
    ))
  }

  <Section>
    <h2 class="mb-2 font-heading text-3xl font-bold text-text">{weitereIdeen.headline}</h2>
    <p class="mb-8 max-w-3xl leading-relaxed text-text-muted">{weitereIdeen.intro}</p>
    <div class="grid gap-6 md:grid-cols-2">
      {weitereIdeen.items.map((item) => <TitledCard title={item.title} text={item.text} />)}
    </div>
  </Section>

  <Section bg="paper" class="bg-surface text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="mb-4 font-heading text-2xl font-bold text-text">{fallstudienHinweis.headline}</h2>
      <p class="mb-6 leading-relaxed text-text-muted">{fallstudienHinweis.text}</p>
      <CtaButton label={fallstudienHinweis.ctaLabel} />
    </div>
  </Section>

  <ClosingCta text={abschlussCta.text} buttonLabel={abschlussCta.buttonLabel} />
</PageLayout>
