---
import PageLayout from '../layouts/PageLayout.astro';
import CtaButton from '../components/CtaButton.astro';
---

<PageLayout title="Seite nicht gefunden" description="Die angeforderte Seite existiert nicht.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="mb-4 font-heading text-4xl font-bold text-text">404 – Seite nicht gefunden</h1>
    <p class="mb-8 text-text-muted">Die angeforderte Seite existiert nicht oder wurde verschoben.</p>
    <a href="/de/" class="mb-8 inline-block text-brand-primary hover:underline">Zur Startseite</a>
    <div>
      <CtaButton />
    </div>
  </section>
</PageLayout>
